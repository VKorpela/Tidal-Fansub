Dialogue: 0,0:00:55.21,0:00:57.40,Rainbow,,0,0,0,,{\K95}{\K17}难{\K14}忘{\K21}奇{\K42}遇
Dialogue: 0,0:00:56.37,0:00:58.31,Pinkie Pie,,0,0,0,,{\K56}{\K12}遍{\K14}地{\K23}欢{\K52}喜
Dialogue: 0,0:00:57.40,0:00:59.59,Rarity,,0,0,0,,{\K56}{\K11}美{\K20}丽{\K30}心{\K33}灵
Dialogue: 0,0:00:58.31,0:01:00.43,Applejack,,0,0,0,,{\K57}{\K28}坚{\K17}强{\K26}卖{\K37}力
